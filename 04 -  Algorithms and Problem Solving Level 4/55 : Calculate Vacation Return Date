#include <iostream>

using namespace std;

struct sDate
{
    short Year;
    short Month;
    short Day;
};

short ReadYear()
{
    short Year = 0;

    cout << "Please enter a Year? ";
    cin >> Year;

    return Year;
}

short ReadMonth()
{
    short Month = 0;

    cout << "Please enter a Month? ";
    cin >> Month;

    return Month;
}

short ReadDay()
{
    short Day = 0;

    cout << "Please enter a Day? ";
    cin >> Day;

    return Day;
}

sDate ReadFullData()
{
    sDate Date;

    Date.Day = ReadDay();
    Date.Month = ReadMonth();
    Date.Year = ReadYear();

    cout << '\n';

    return Date;
}

bool IsLeapYear(short Year)
{
    return (Year % 400 == 0) || (Year % 4 == 0 && Year % 100 != 0);
}

short NumberOfDaysInAMonth(short Year, short Month)
{
    if (Month < 1 || Month > 12)
        return 0;

    short NumberOfDays[12] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31,30,31 };

    return (Month == 2) ? (IsLeapYear(Year) ? 29 : 28) : NumberOfDays[Month - 1];
}

bool IsLastDayInMonth(sDate Date)
{
    return (NumberOfDaysInAMonth(Date.Year, Date.Month) == Date.Day);
}

bool IsLastMonthInYear(short Month)
{
    return (Month == 12);
}

bool IsDate1BeforDate2(sDate Date1, sDate Date2)
{
    return  (Date1.Year < Date2.Year) ? true :
        ((Date1.Year == Date2.Year) ? (Date1.Month < Date2.Month ? true : (Date1.Month == Date2.Month ? Date1.Day < Date2.Day : false)) : false);
}

sDate IncreaseDateByOneDay(sDate Date)
{
    if (IsLastDayInMonth(Date))
    {
        if (IsLastMonthInYear(Date.Month))
        {
            Date.Day = 1;
            Date.Month = 1;
            Date.Year++;
        }
        else
        {
            Date.Day = 1;
            Date.Month++;
        }
    }
    else
    {
        Date.Day++;
    }

    return Date;
}

string GetDayName(short Day)
{
    string arrDayNames[7] = { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };

    return arrDayNames[Day];
}

short DayOfWeekOrder(short Year, short Month, short Day)
{
    short A = (14 - Month) / 12;
    short Y = Year - A;
    short M = Month + (12 * A) - 2;

    return  (Day + Y + (Y / 4) - (Y / 100) + (Y / 400) + (31 * M / 12)) % 7;
}

short DayOfWeekOrder(sDate Date)
{
    return DayOfWeekOrder(Date.Year, Date.Month, Date.Day);
}

bool IsWeekend(sDate Date)
{
    short DayIndex = DayOfWeekOrder(Date);

    return (DayIndex == 5 || DayIndex == 6);
}

short ReadVacationDays()
{
    short VacationDays = 0;

    cout << "Please Enter Vacation Days ? ";
    cin >> VacationDays;

    return VacationDays;
}

sDate CalculateVacationReturnDate(sDate DateFrom, short VacationDays)
{
    short WeekEndCounter = 0;

    while (IsWeekend(DateFrom))
    {
        DateFrom = IncreaseDateByOneDay(DateFrom);
    }

    for (short i = 1; i <= VacationDays + WeekEndCounter; i++)
    {
        if (IsWeekend(DateFrom))
            WeekEndCounter++;

        DateFrom = IncreaseDateByOneDay(DateFrom);
    }

    while (IsWeekend(DateFrom))
    {
        DateFrom = IncreaseDateByOneDay(DateFrom);
    }

    return DateFrom;
}

int main()
{
    cout << "Vacation Starts : \n";
    sDate DateFrom = ReadFullData();

    short VacationDays = ReadVacationDays();

    DateFrom = CalculateVacationReturnDate(DateFrom, VacationDays);

    cout << "\n\nReturn Date : " << GetDayName(DayOfWeekOrder(DateFrom))
        << " , " << DateFrom.Day << "/" << DateFrom.Month << "/" << DateFrom.Year << endl;

    return 0;
}
