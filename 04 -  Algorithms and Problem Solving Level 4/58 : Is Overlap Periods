#include <iostream>

using namespace std;

enum enDateCompare { Before = -1, Equal = 0, After = 1 };

struct sDate
{
    short Year;
    short Month;
    short Day;
};

struct stPeriod
{
    sDate StartDate;
    sDate EndDate;`
};

short ReadYear()
{
    short Year = 0;

    cout << "Please enter a Year? ";
    cin >> Year;

    return Year;
}

short ReadMonth()
{
    short Month = 0;

    cout << "Please enter a Month? ";
    cin >> Month;

    return Month;
}

short ReadDay()
{
    short Day = 0;

    cout << "Please enter a Day? ";
    cin >> Day;

    return Day;
}

sDate ReadFullData()
{
    sDate Date;

    Date.Day = ReadDay();
    Date.Month = ReadMonth();
    Date.Year = ReadYear();

    cout << '\n';

    return Date;
}

stPeriod ReadPeriod()
{
    stPeriod Period;

    cout << "\nEnter Start Date : \n";
    Period.StartDate = ReadFullData();

    cout << "Enter End Date : \n";
    Period.EndDate = ReadFullData();

    return Period;
}

bool IsDate1BeforDate2(sDate Date1, sDate Date2)
{
    return  (Date1.Year < Date2.Year) ? true :
        ((Date1.Year == Date2.Year) ? (Date1.Month < Date2.Month ? true : (Date1.Month == Date2.Month ? Date1.Day < Date2.Day : false)) : false);
}

bool IsDate1EqualDate2(sDate Date1, sDate Date2)
{
    return (Date1.Year == Date2.Year) ? (Date1.Month == Date2.Month) ? (Date1.Day == Date2.Day) ? true : false : false : false;
}

bool IsDate1AfterDate2(sDate Date1, sDate Date2)
{
    return (!IsDate1BeforDate2(Date1, Date2) && !IsDate1EqualDate2(Date1, Date2));
}

enDateCompare CompareDates(sDate Date1, sDate Date2)
{
    if (IsDate1BeforDate2(Date1, Date2))
        return enDateCompare::Before;

    if (IsDate1EqualDate2(Date1, Date2))
        return enDateCompare::Equal;

    return enDateCompare::After;
}

bool IsOverlapPeriods(stPeriod Period1, stPeriod Period2)
{
    if (CompareDates(Period2.EndDate, Period1.StartDate) == enDateCompare::Before
        ||
        CompareDates(Period2.StartDate, Period1.EndDate) == enDateCompare::After)
        return 0;
    else
        return 1;
}

int main()
{
    stPeriod Period1, Period2;
   
    cout << "Please Enter Period1 : \n";
    Period1 = ReadPeriod();

    cout << "Please Enter Period2 : \n";
    Period2 = ReadPeriod();

    if (IsOverlapPeriods(Period1, Period2))
        cout << "Yes, Periods Overlap.\n\n";
    else
        cout << "No, Periods do Not Overlap.\n\n";

    return 0;
}
