#include <iostream>

using namespace std;

short ReadYear()
{
    short Year = 0;

    cout << "Please enter a Year to check ?\n";
    cin >> Year;

    return Year;
}

bool IsLeapYear(short Year)
{
    return (Year % 400 == 0) || (Year % 4 == 0 && Year % 100 != 0);
}

int main()
{
    short Year = ReadYear();

    if (IsLeapYear(Year))
        cout << "\n Yes, Year [ " << Year << " ] is a Leap Year.\n";
    else
        cout << "\n No, Year [ " << Year << " ] is NOT a Leap Year.\n";

    return 0;
}
