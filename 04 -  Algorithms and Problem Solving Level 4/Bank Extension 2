bool FindUserByUsernameAndPassword(string Username, string Password, stUser& User)
{
    vector <stUser> vUsers = LoadUsersDateFromFile(UsersFile);

    for (stUser& U : vUsers)
    {
        if (U.Username == Username && U.Password == Password)
        {
            User = U;

            return true;
        }
    }

    return false;
}

void Login()
{
    do
    {
        system("cls");

        cout << "==============================\n";
        cout << "\tLogin Screen.\n";
        cout << "==============================\n";

        User.Username = ReadUsername();
        User.Password = ReadPassword();

    } while (!FindUserByUsernameAndPassword(::User.Username, ::User.Password, User));

    ShowMainMenue();

}

