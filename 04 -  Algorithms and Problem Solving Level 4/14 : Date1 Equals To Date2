#include <iostream>

using namespace std;

struct sDate
{
    short Year;
    short Month;
    short Day;
};

short ReadYear()
{
    short Year = 0;

    cout << "Please enter a Year? ";
    cin >> Year;

    return Year;
}

short ReadMonth()
{
    short Month = 0;

    cout << "Please enter a Month? ";
    cin >> Month;

    return Month;
}

short ReadDay()
{
    short Day = 0;

    cout << "Please enter a Day? ";
    cin >> Day;

    return Day;
}

sDate ReadFullData()
{
    sDate Date;

    Date.Day = ReadDay();
    Date.Month = ReadMonth();
    Date.Year = ReadYear();

    return Date;
}

bool IsDate1EqualDate2(sDate Date1, sDate Date2)
{
    return (Date1.Year == Date2.Year) ? (Date1.Month == Date2.Month) ? (Date1.Day == Date2.Day) ? true : false : false : false;
}

int main()
{
    sDate Date1 = ReadFullData();
    cout << '\n';
    sDate Date2 = ReadFullData();

    if (IsDate1EqualDate2(Date1, Date2))
        cout << "\n Yes, Date1 is Equal To Date2.\n";
    else
        cout << "\n No, Date1 is NOT Equal To Date2.\n";

    return 0;
}
