#include <iostream>

using namespace std;

struct sDate
{
    short Year;
    short Month;
    short Day;
};

struct stPeriod
{
    sDate StartDate;
    sDate EndDate;
};

short ReadYear()
{
    short Year = 0;

    cout << "Please enter a Year? ";
    cin >> Year;

    return Year;
}

short ReadMonth()
{
    short Month = 0;

    cout << "Please enter a Month? ";
    cin >> Month;

    return Month;
}

short ReadDay()
{
    short Day = 0;

    cout << "Please enter a Day? ";
    cin >> Day;

    return Day;
}

sDate ReadFullData()
{
    sDate Date;

    Date.Day = ReadDay();
    Date.Month = ReadMonth();
    Date.Year = ReadYear();

    cout << '\n';

    return Date;
}

stPeriod ReadPeriod()
{
    stPeriod Period;

    cout << "\nEnter Start Date : \n";
    Period.StartDate = ReadFullData();

    cout << "Enter End Date : \n";
    Period.EndDate = ReadFullData();

    return Period;
}

bool IsDate1BeforDate2(sDate Date1, sDate Date2)
{
    return  (Date1.Year < Date2.Year) ? true :
        ((Date1.Year == Date2.Year) ? (Date1.Month < Date2.Month ? true : (Date1.Month == Date2.Month ? Date1.Day < Date2.Day : false)) : false);
}

bool IsLeapYear(short Year)
{
    return (Year % 400 == 0) || (Year % 4 == 0 && Year % 100 != 0);
}

short NumberOfDaysInAMonth(short Year, short Month)
{
    if (Month < 1 || Month > 12)
        return 0;

    short NumberOfDays[12] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31,30,31 };

    return (Month == 2) ? (IsLeapYear(Year) ? 29 : 28) : NumberOfDays[Month - 1];
}

bool IsLastDayInMonth(sDate Date)
{
    return (NumberOfDaysInAMonth(Date.Year, Date.Month) == Date.Day);
}

bool IsLastMonthInYear(short Month)
{
    return (Month == 12);
}

sDate IncreaseDateByOneDay(sDate Date)
{
    if (IsLastDayInMonth(Date))
    {
        if (IsLastMonthInYear(Date.Month))
        {
            Date.Day = 1;
            Date.Month = 1;
            Date.Year++;
        }
        else
        {
            Date.Day = 1;
            Date.Month++;
        }
    }
    else
    {
        Date.Day++;
    }

    return Date;
}

int GetDifferenceInDays(sDate Date1, sDate Date2, bool IncludingEndDay = false)
{
    int Days = 0;

    while (IsDate1BeforDate2(Date1, Date2))
    {
        Days++;

        Date1 = IncreaseDateByOneDay(Date1);
    }

    return IncludingEndDay ? ++Days : Days;
}

int PeriodLengthInDays(stPeriod Period, bool IncludingEndDay = false)
{
    return GetDifferenceInDays(Period.StartDate, Period.EndDate, IncludingEndDay);
}

int main()
{
    stPeriod Period;
   
    cout << "Please Enter Period : \n";
    Period = ReadPeriod();

    cout << "Period Length is : " << PeriodLengthInDays(Period) << endl;
    cout << "Period Length (Including End Day) is : " << PeriodLengthInDays(Period, true) << endl;
  
    return 0;
}
