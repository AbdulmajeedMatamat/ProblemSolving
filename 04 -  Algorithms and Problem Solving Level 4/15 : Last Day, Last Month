#include <iostream>

using namespace std;

struct sDate
{
    short Year;
    short Month;
    short Day;
};

short ReadYear()
{
    short Year = 0;

    cout << "Please enter a Year? ";
    cin >> Year;

    return Year;
}

short ReadMonth()
{
    short Month = 0;

    cout << "Please enter a Month? ";
    cin >> Month;

    return Month;
}

short ReadDay()
{
    short Day = 0;

    cout << "Please enter a Day? ";
    cin >> Day;

    return Day;
}

sDate ReadFullData()
{
    sDate Date;

    Date.Day = ReadDay();
    Date.Month = ReadMonth();
    Date.Year = ReadYear();

    return Date;
}

bool IsLeapYear(short Year)
{
    return (Year % 400 == 0) || (Year % 4 == 0 && Year % 100 != 0);
}

short NumberOfDaysInAMonth(short Year, short Month)
{
    if (Month < 1 || Month > 12)
        return 0;

    short NumberOfDays[12] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31,30,31 };

    return (Month == 2) ? (IsLeapYear(Year) ? 29 : 28) : NumberOfDays[Month - 1];
}

bool IsLastDayInMonth(sDate Date)
{
    return (NumberOfDaysInAMonth(Date.Year, Date.Month) == Date.Day);
}

bool IsLastMonthInYear(short Month)
{
    return (Month == 12);
}

int main()
{
    sDate Date = ReadFullData();

    if (IsLastDayInMonth(Date))
        cout << "\n Yes, Day is Last Day in Month.";
    else
        cout << "\n No, Day is NOT Last Day in Month.";

    if (IsLastMonthInYear(Date.Month))
        cout << "\n Yes, Month is Last Month in Year.";
    else
        cout << "\n No, Month is NOT Last Month in Year.";
    
    return 0;
}
